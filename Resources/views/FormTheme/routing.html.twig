{% block webanyone_form_routing_widget %}
{{ form_errors(form) }}
<div class="row">
    <div class="col-sm-8">{{ form_row(form.subject) }}</div>
    <div class="col-sm-4">{{ form_row(form.set_replyto) }}</div>
</div>
<div class="row">
    <div class="col-sm-8" id="webanyoneFormRoutingMessage">
        {{ form_row(form.message) }}
    </div>
    <div class="col-sm-4">
        <label class="control-label">{{ 'webanyone.formrouting.tokens'|trans }}</label>
        <div id="webanyoneFormRoutingTokens" class="list-group" style="max-height: 250px; overflow-y: auto;">
            {% for token, label in routingTokens %}
                <a class="list-group-item ellipsis" href="#" onclick="Mautic.insertTextInEditor(mQuery('#formaction_properties_message'), '{{ token|e('js') }}'); return false;">{{ label }}</a>
            {% endfor %}
        </div>
    </div>
</div>
{{ form_row(form.contact) }}
<p class="help-block">{{ 'webanyone.formrouting.help'|trans }}</p>
{{ form_row(form.fallback) }}
{% for bank in form.banks %}
    <details{% if bank.vars.name == routingSelectedKey %} open{% endif %}>
        <summary>{{ bank.vars.label }}</summary>
        {% for row in bank.rows %}
            <div class="panel panel-default">
                <div class="panel-heading">{{ row.vars.label }}</div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-sm-4">{{ form_row(row.to) }}</div>
                        <div class="col-sm-4">{{ form_row(row.cc) }}</div>
                        <div class="col-sm-4">{{ form_row(row.bcc) }}</div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </details>
{% endfor %}
{% endblock %}
